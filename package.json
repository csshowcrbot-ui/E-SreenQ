{
  "name": "e-screenq-cancer-screening-system",
  "version": "1.0.0",
  "description": "癌症篩檢問卷系統 (胃幽門螺旋桿菌、口腔黏膜、大腸糞便潛血、子宮頸抹片、肺癌LDCT、乳房X光攝影檢查紀錄與個管系統)",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
